# Copy to frontend/.env.local for local development. It is gitignored.
# NEXT_PUBLIC_ values reach the browser, so never put secrets in them.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only. The Neon Auth URL of the branch this app signs in against (`dev` locally,
# `production` on Vercel), from the Neon console or `get_neon_auth_config`.
NEON_AUTH_BASE_URL=
# Server-only. Signs the session cookie cache. At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
