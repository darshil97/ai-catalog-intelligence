# Copy to backend/.env for local development. backend/.env is gitignored.

APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Neon `dev` branch locally. Never the `production` branch.
# Pooled endpoint (host contains -pooler), used at runtime:
DATABASE_URL=
# Direct endpoint, used by migrations:
DATABASE_URL_DIRECT=

# Neon `test` branch, pooling on. Tests erase its queue tables, so never use dev or production.
TEST_DATABASE_URL=
# Endpoint ID of the Neon `production` branch (the ep-... part of its host). A local worker
# and the tests refuse any URL containing it. Optional, but set it if you have production.
PRODUCTION_DB_ENDPOINT=

# Neon Auth URL of the `dev` branch, for checking sign-in tokens. Not a secret.
NEON_AUTH_BASE_URL=
# Comma-separated emails always let in, such as your own. Empty lets no one in while
# SIGNUPS_ENABLED is false, so set it (on Render too).
# ACCESS_ALLOWLIST=
# Optional. Off by default: everyone not allowlisted is waitlisted.
# SIGNUPS_ENABLED=false

# Bedrock API key: local development and the model review only.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-2

# File storage. Local development uses the dev/ prefix of the shared bucket, with the
# catalog-dev IAM user's access key (never the catalog-api key). It can't reach prod/.
S3_PREFIX=dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
